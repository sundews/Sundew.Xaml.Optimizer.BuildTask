<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
	  <_TargetFramework Condition="'$(MSBuildRuntimeType)' == 'Full'">netstandard2.0</_TargetFramework>
	  <_TargetFramework Condition="'$(MSBuildRuntimeType)' == 'Core'">net8.0</_TargetFramework>
	  <_SundewXamlOptimizerMerged >$(MSBuildThisFileDirectory)..\tools\$(_TargetFramework)\Sundew.Xaml.Optimizer.BuildTask.m.dll</_SundewXamlOptimizerMerged>
	  <_SundewXamlOptimizer Condition="Exists($(_SundewXamlOptimizerMerged))">$(_SundewXamlOptimizerMerged)</_SundewXamlOptimizer>
	  <_SundewXamlOptimizer Condition="'$(_SundewXamlOptimizer)'==''">$(MSBuildThisFileDirectory)..\tools\$(_TargetFramework)\Sundew.Xaml.Optimizer.BuildTask.dll</_SundewXamlOptimizer>
  </PropertyGroup>
  <UsingTask
    TaskName="XamlOptimizerTask"
    AssemblyFile="$(_SundewXamlOptimizer)"
    TaskFactory="TaskHostFactory"/>

  <Target Name="OptimizeXamlResources" BeforeTargets="XamlMarkupCompilePass1;MarkupCompilePass1;_FindXamlGFiles;PrepareToCompileAvaloniaXaml"
          Condition="!$(DefineConstants.Contains('DISABLE_SXO')) AND $(DesignTimeBuild) != true AND $(BuildingProject) == true">
    <!--
        The markup compiler resolves its generated files as $(IntermediateOutputPath) combined with the path of the xaml
        file relative to the project directory, so every character of the staging directory is repeated in the path of
        every generated file. The optimizer therefore derives a short staging directory below
        $(BaseIntermediateOutputPath), which also keeps the staged xaml out of the default item globs and within reach of
        Clean. Set $(SxoIntermediateOutputPath) to stage somewhere else.
    -->
    <PropertyGroup>
      <_SxoIntermediateOutputPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))))</_SxoIntermediateOutputPath>
      <_SxoBaseIntermediateOutputPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))))</_SxoBaseIntermediateOutputPath>
      <_SxoStagingPath Condition="'$(SxoIntermediateOutputPath)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(SxoIntermediateOutputPath)'))))</_SxoStagingPath>
    </PropertyGroup>
    <CreateItem Include="@(EmbeddedResource)" Condition="'%(Extension)' == '.xaml'">
      <Output TaskParameter="Include" ItemName="EmbeddedXamlResource"/>
    </CreateItem>
    <XamlOptimizerTask
	    TreatWarningsAsErrors="$(TreatWarningsAsErrors)"
	    Optimizers="@(Sxo)"
      ReferencePaths="@(ReferencePath)"
      PackageReferences="@(PackageReference)"
      TargetPlatformIdentifier="$(TargetPlatformIdentifier)"
      ApplicationDefinitions="@(ApplicationDefinition)"
      Pages="@(Page)"
      EmbeddedXamlResources="@(EmbeddedXamlResource)"
      AvaloniaXaml="@(AvaloniaXaml)"
      MauiXaml="@(MauiXaml)"
      Compiles="@(Compile)"
      ProjectDirectory="$(MSBuildProjectDirectory)"
      AssemblyName="$(AssemblyName)"
      RootNamespace="$(RootNamespace)"
      IntermediateOutputPath="$(_SxoIntermediateOutputPath)"
      BaseIntermediateOutputPath="$(_SxoBaseIntermediateOutputPath)"
      SxoIntermediateOutputPath="$(_SxoStagingPath)"
      SolutionDirectory="$(SolutionDir)"
      UseWinUI="$(UseWinUI)"
      UseWPF="$(UseWPF)"
      UseMaui="$(UseMaui)"
      Debug="$(DefineConstants.Contains('DEBUG_SXO_TOOL'))"
      DebugOnError="$(DefineConstants.Contains('DEBUG_SXO_ON_ERROR'))"
	    MaxParallelization="$(Sxo_MaxParallelization)">
      <Output ItemName="ObsoletePages" TaskParameter="ObsoletePages"/>
	    <Output ItemName="OptimizedPages" TaskParameter="OptimizedPages"/>
	    <Output ItemName="ObsoleteAvaloniaXaml" TaskParameter="ObsoleteAvaloniaXaml"/>
      <Output ItemName="OptimizedAvaloniaXaml" TaskParameter="OptimizedAvaloniaXaml"/>
	    <Output ItemName="ObsoleteMauiXaml" TaskParameter="ObsoleteMauiXaml"/>
	    <Output ItemName="OptimizedMauiXaml" TaskParameter="OptimizedMauiXaml"/>
      <Output ItemName="ObsoleteEmbeddedXamlResources" TaskParameter="ObsoleteEmbeddedXamlResources"/>
      <Output ItemName="OptimizedEmbeddedXamlResources" TaskParameter="OptimizedEmbeddedXamlResources"/>
      <Output ItemName="ObsoleteApplicationDefinitions" TaskParameter="ObsoleteApplicationDefinitions"/>
      <Output ItemName="OptimizedApplicationDefinitions" TaskParameter="OptimizedApplicationDefinitions"/>
	    <Output ItemName="NewPages" TaskParameter="NewPages"/>
	    <Output ItemName="NewAvaloniaXaml" TaskParameter="NewAvaloniaXaml"/>
	    <Output ItemName="NewMauiXaml" TaskParameter="NewMauiXaml"/>
	    <Output ItemName="NewEmbeddedResources" TaskParameter="NewEmbeddedResources"/>
      <Output ItemName="NewCompiles" TaskParameter="NewCompiles"/>
      <Output ItemName="NewAdditionalFiles" TaskParameter="NewAdditionalFiles"/>
      <Output PropertyName="_SxoMarkupCompileStateInvalidated" TaskParameter="MarkupCompileStateInvalidated"/>
    </XamlOptimizerTask>
    <!--
        The markup compiler keys its incremental state to the xaml files of the previous build and only recompiles pages
        with local types when that set changes, so a moved xaml file leaves it describing files that are no longer there.
        Discarding the state forces a full markup compile pass, so that what it hands to ResourcesGenerator matches disk.
    -->
    <ItemGroup Condition="'$(_SxoMarkupCompileStateInvalidated)' == 'true' AND '$(AssemblyName)' != ''">
      <_SxoObsoleteMarkupCompileState Include="$(_SxoIntermediateOutputPath)$(AssemblyName)_MarkupCompile.cache"/>
      <_SxoObsoleteMarkupCompileState Include="$(_SxoIntermediateOutputPath)$(AssemblyName)_MarkupCompile.i.cache"/>
      <_SxoObsoleteMarkupCompileState Include="$(_SxoIntermediateOutputPath)$(AssemblyName)_MarkupCompile.lref"/>
      <_SxoObsoleteMarkupCompileState Include="$(_SxoIntermediateOutputPath)$(AssemblyName)_MarkupCompile.i.lref"/>
    </ItemGroup>
    <Delete Files="@(_SxoObsoleteMarkupCompileState)" ContinueOnError="true" Condition="'@(_SxoObsoleteMarkupCompileState)' != ''"/>
    <ItemGroup>
      <FileWrites Include="$(_SxoIntermediateOutputPath)sxo.filelist"/>
	    <Page Remove="@(ObsoletePages)"/>
	    <Page Include="@(OptimizedPages)"/>
	    <FileWrites Include="@(OptimizedPages)"/>
	    <AvaloniaXaml Remove="@(ObsoleteAvaloniaXaml)"/>
      <AvaloniaXaml Include="@(OptimizedAvaloniaXaml)"/>
	    <FileWrites Include="@(ObsoleteAvaloniaXaml)"/>
	    <MauiXaml Remove="@(ObsoleteMauiXaml)"/>
	    <MauiXaml Include="@(OptimizedMauiXaml)"/>
	    <FileWrites Include="@(OptimizedMauiXaml)"/>
      <EmbeddedResource Remove="@(ObsoleteEmbeddedXamlResources)"/>
      <EmbeddedResource Include="@(OptimizedEmbeddedXamlResources)"/>
      <FileWrites Include="@(OptimizedEmbeddedXamlResources)"/>
      <ApplicationDefinition Remove="@(ObsoleteApplicationDefinitions)"/>
      <ApplicationDefinition Include="@(OptimizedApplicationDefinitions)"/>
      <FileWrites Include="@(OptimizedApplicationDefinitions)"/>
      <AvaloniaXaml Include="@(NewAvaloniaXaml)"/>
      <FileWrites Include="@(NewAvaloniaXaml)"/>
	    <MauiXaml Include="@(NewMauiXaml)"/>
	    <FileWrites Include="@(NewMauiXaml)"/>
      <Page Include="@(NewPages)"/>
      <FileWrites Include="@(NewPages)"/>
      <EmbeddedResource Include="@(NewEmbeddedResources)"/>
      <FileWrites Include="@(NewEmbeddedResources)"/>
      <Compile Include="@(NewCompiles)"/>
      <FileWrites Include="@(NewCompiles)"/>
      <_GeneratedCodeFiles Include="@(NewCompiles)"/>
      <AdditionalFiles Include="@(NewAdditionalFiles)"/>
      <FileWrites Include="@(NewAdditionalFiles)"/>
    </ItemGroup>
  </Target>
</Project>